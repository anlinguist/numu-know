rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /documents/{document} {
    	allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /drafts/{document} {
    	allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /users/{uid} {
    	allow read: if request.auth.uid == uid;
      // No client writes: notification preferences go through the
      // updateUserPreferences server action (Admin SDK), which validates them.
    }
    match /allDocuments/drafts {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /allDocuments/live {
    	allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /ytvids {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /ytvids/{vid} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
    }
    match /pages/home {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
  }
}
